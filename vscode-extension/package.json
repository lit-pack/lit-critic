{
  "name": "lit-critic",
  "displayName": "lit-critic",
  "description": "Multi-lens editorial review system for fiction manuscripts",
"version": "5.1.1",
  "publisher": "lit-pack",
  "repository": {
    "type": "git",
    "url": "https://github.com/lit-pack/literary-critic.git",
    "directory": "vscode-extension"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:CANON.md"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "litCritic.analyze",
        "title": "Analyze (AI)",
        "icon": "$(search)"
      },
      {
        "command": "litCritic.refreshKnowledge",
        "title": "Update (AI)",
        "icon": "$(refresh)"
      },
      {
        "command": "litCritic.resetKnowledgeOverride",
        "title": "lit-critic: Reset Knowledge Override",
        "icon": "$(discard)"
      },
      {
        "command": "litCritic.deleteKnowledgeEntity",
        "title": "lit-critic: Delete Knowledge Entity",
        "icon": "$(trash)"
      },
      {
        "command": "litCritic.openKnowledgeReviewPanel",
        "title": "lit-critic: Open Knowledge Review Panel",
        "icon": "$(edit)"
      },
      {
        "command": "litCritic.nextKnowledgeEntity",
        "title": "lit-critic: Next Knowledge Entity"
      },
      {
        "command": "litCritic.previousKnowledgeEntity",
        "title": "lit-critic: Previous Knowledge Entity"
      },
      {
        "command": "litCritic.resetAllKnowledge",
        "title": "Reset",
        "icon": "$(clear-all)"
      },
      {
        "command": "litCritic.resetAllAnalysis",
        "title": "Reset",
        "icon": "$(clear-all)"
      },
      {
        "command": "litCritic.refreshLearning",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "litCritic.exportLearning",
        "title": "Export",
        "icon": "$(export)"
      },
      {
        "command": "litCritic.resetLearning",
        "title": "Reset",
        "icon": "$(clear-all)"
      },
      {
        "command": "litCritic.deleteLearningEntry",
        "title": "lit-critic: Delete Learning Entry",
        "icon": "$(trash)"
      },
      {
        "command": "litCritic.selectFinding",
        "title": "lit-critic: Select Finding"
      },
      {
        "command": "litCritic.reviewFinding",
        "title": "lit-critic: Review Current Finding"
      },
      {
        "command": "litCritic.selectModel",
        "title": "Config",
        "icon": "$(settings-gear)"
      },
      {
        "command": "litCritic.stopServer",
        "title": "lit-critic: Stop Server"
      },
      {
        "command": "litCritic.toggleEntityLock",
        "title": "lit-critic: Toggle Knowledge Lock",
        "icon": "$(lock)"
      },
      {
        "command": "litCritic.keepFlaggedEntity",
        "title": "lit-critic: Keep Flagged Entity",
        "icon": "$(check)"
      },
      {
        "command": "litCritic.deleteFlaggedEntity",
        "title": "lit-critic: Delete Flagged Entity",
        "icon": "$(trash)"
      },
      {
        "command": "litCritic.renameScene",
        "title": "lit-critic: Rename Scene…",
        "icon": "$(edit)"
      },
      {
        "command": "litCritic.purgeOrphanedSceneRefs",
        "title": "lit-critic: Clean Up Stale Scene References",
        "icon": "$(trash)"
      },
      {
        "command": "litCritic.navigateToFinding",
        "title": "lit-critic: Navigate to Finding",
        "icon": "$(go-to-file)"
      },
      {
        "command": "litCritic.deleteSceneAnalysis",
        "title": "lit-critic: Delete Scene Analysis",
        "icon": "$(trash)"
      }
    ],
    "configuration": {
      "title": "lit-critic",
      "properties": {
        "litCritic.repoPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the lit-critic installation directory (containing lit-critic-server.py). Required when opening a scene folder that is not inside the lit-critic repo."
        },
        "litCritic.pythonPath": {
          "type": "string",
          "default": "python",
          "scope": "machine",
          "description": "Path to Python interpreter"
        },
        "litCritic.serverPort": {
          "type": "number",
          "default": 8000,
          "description": "Port for the backend server"
        },
        "litCritic.analysisModel": {
          "type": "string",
          "default": "sonnet",
          "order": 41,
          "enum": [
            "opus",
            "sonnet",
            "haiku"
          ],
          "enumDescriptions": [
            "Opus — deepest analysis, highest quality, highest cost.",
            "Sonnet — balanced analysis, recommended default.",
            "Haiku — fast and cheap, lighter analysis."
          ],
          "description": "Model used for analysis. Passed directly to the backend."
        },
        "litCritic.sceneFolder": {
          "type": "string",
          "default": "text",
          "order": 47,
          "description": "Scene folder (relative to project root) used for scene discovery and refresh watchers."
        },
        "litCritic.sceneExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "txt"
          ],
          "order": 48,
          "description": "Scene file extensions (without dots) used for scene discovery and refresh watchers."
        },
        "litCritic.autoStartServer": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the backend server on activation"
        },
        "litCritic.disableProblemDecorationColors": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, lit-critic sets workspace setting workbench.editor.decorations.colors=false to reduce diagnostic color tinting in file/tab labels. Affects all diagnostics in this workspace."
        },
        "litCritic.disableProblemDecorationBadges": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, lit-critic sets workspace setting workbench.editor.decorations.badges=false. Affects all diagnostics in this workspace."
        },
        "litCritic.knowledgeReviewPassTrigger": {
          "type": "string",
          "default": "always",
          "enum": [
            "always",
            "on_stale",
            "never"
          ],
          "enumDescriptions": [
            "Always run the reconciliation review pass after knowledge refresh.",
            "Only run when at least one scene was re-extracted.",
            "Never run the reconciliation review pass."
          ],
          "description": "Controls when the knowledge reconciliation review pass runs after a refresh."
        },
        "litCritic.autoUpdateOnSave": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "knowledge"
          ],
          "enumDescriptions": [
            "Manual only — no automatic AI work on save.",
            "Automatically update knowledge when changed scenes are detected on save."
          ],
          "description": "Controls automatic AI re-extraction when scene files are saved. 'off' = manual only; 'knowledge' = automatically update knowledge when changed scenes are detected on save."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lit-critic",
          "title": "lit-critic",
          "icon": "$(book)"
        },
        {
          "id": "lit-critic-review",
          "title": "lit-critic Review",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "lit-critic-review": [
        {
          "id": "litCritic.knowledgeReviewView",
          "name": "Knowledge Review",
          "type": "webview",
          "when": "litCritic.serverRunning"
        },
        {
          "id": "litCritic.discussionView",
          "name": "Findings Review",
          "type": "webview",
          "when": "litCritic.serverRunning"
        }
      ],
      "lit-critic": [
        {
          "id": "litCritic.scenes",
          "name": "Inputs"
        },
        {
          "id": "litCritic.indexes",
          "name": "Knowledge"
        },
        {
          "id": "litCritic.sessions",
          "name": "Analysis"
        },
        {
          "id": "litCritic.findings",
          "name": "Findings"
        },
        {
          "id": "litCritic.learning",
          "name": "Learning"
        }
      ]
    },
    "menus": {
      "commandPalette": [],
      "view/item/context": [
        {
          "command": "litCritic.deleteLearningEntry",
          "when": "view == litCritic.learning && viewItem == learningEntry",
          "group": "inline"
        },
        {
          "command": "litCritic.resetKnowledgeOverride",
          "when": "view == litCritic.indexes && viewItem == knowledgeEntityOverridden",
          "group": "inline"
        },
        {
          "command": "litCritic.deleteKnowledgeEntity",
          "when": "view == litCritic.indexes && viewItem == knowledgeEntity",
          "group": "inline"
        },
        {
          "command": "litCritic.deleteKnowledgeEntity",
          "when": "view == litCritic.indexes && viewItem == knowledgeEntityOverridden",
          "group": "inline"
        },
        {
          "command": "litCritic.toggleEntityLock",
          "when": "view == litCritic.indexes && viewItem == knowledgeEntity",
          "group": "inline"
        },
        {
          "command": "litCritic.toggleEntityLock",
          "when": "view == litCritic.indexes && viewItem == knowledgeEntityOverridden",
          "group": "inline"
        },
        {
          "command": "litCritic.toggleEntityLock",
          "when": "view == litCritic.indexes && viewItem == knowledgeEntityLocked",
          "group": "inline"
        },
        {
          "command": "litCritic.keepFlaggedEntity",
          "when": "view == litCritic.indexes && viewItem == knowledgeEntityFlagged",
          "group": "inline@1"
        },
        {
          "command": "litCritic.deleteFlaggedEntity",
          "when": "view == litCritic.indexes && viewItem == knowledgeEntityFlagged",
          "group": "inline@2"
        },
        {
          "command": "litCritic.renameScene",
          "when": "view == litCritic.scenes && viewItem == sceneProjection",
          "group": "1_modification@1"
        },
        {
          "command": "litCritic.deleteSceneAnalysis",
          "when": "view == litCritic.sessions && viewItem == analysisScene",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "litCritic.resetAllKnowledge",
          "when": "view == litCritic.indexes",
          "group": "navigation"
        },
        {
          "command": "litCritic.refreshKnowledge",
          "when": "view == litCritic.indexes",
          "group": "navigation"
        },
        {
          "command": "litCritic.resetAllAnalysis",
          "when": "view == litCritic.sessions",
          "group": "navigation"
        },
        {
          "command": "litCritic.analyze",
          "when": "view == litCritic.sessions",
          "group": "navigation"
        },
        {
          "command": "litCritic.selectModel",
          "when": "view == litCritic.sessions",
          "group": "navigation"
        },
        {
          "command": "litCritic.refreshLearning",
          "when": "view == litCritic.learning",
          "group": "navigation"
        },
        {
          "command": "litCritic.exportLearning",
          "when": "view == litCritic.learning",
          "group": "navigation"
        },
        {
          "command": "litCritic.resetLearning",
          "when": "view == litCritic.learning",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "litCritic.analyze",
          "when": "resourceExtname == .txt",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "litCritic.analyze",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      },
      {
        "command": "litCritic.nextFinding",
        "key": "ctrl+shift+]",
        "mac": "cmd+shift+]",
        "when": "editorTextFocus"
      }
    ],
    "colors": [
      {
        "id": "litCritic.authorOverrideForeground",
        "description": "Color for locked knowledge entries (tree view) and overridden fields (knowledge review panel).",
        "defaults": {
          "dark": "#C8A84B",
          "light": "#7A6000",
          "highContrast": "#FFCC00",
          "highContrastLight": "#7A6000"
        }
      },
      {
        "id": "litCritic.flaggedForReviewForeground",
        "description": "Color for knowledge entries flagged for review by the reconciliation pass.",
        "defaults": {
          "dark": "#E0943A",
          "light": "#B06B1A",
          "highContrast": "#FFA040",
          "highContrastLight": "#B06B1A"
        }
      },
      {
        "id": "litCritic.overriddenForeground",
        "description": "Color for knowledge entries that have author overrides applied.",
        "defaults": {
          "dark": "#5BAFAF",
          "light": "#2E7A7A",
          "highContrast": "#70D0D0",
          "highContrastLight": "#2E7A7A"
        }
      },
      {
        "id": "litCritic.staleForeground",
        "description": "Color for stale inputs, knowledge entries, and sessions in tree views.",
        "defaults": {
          "dark": "#CB6B6B",
          "light": "#A14040",
          "highContrast": "#FF6B6B",
          "highContrastLight": "#A14040"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "npx @vscode/vsce package",
    "test": "mocha"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.33",
    "@types/proxyquire": "^1.3.31",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "mocha": "^10.2.0",
    "proxyquire": "^2.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
